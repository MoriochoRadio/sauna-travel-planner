# ── 카카오 로컬 검색 REST API (실시간 사우나/온천/숙소 조회) ──
# 발급: https://developers.kakao.com → 앱 만들기 → REST API 키
# 무료, 심사 불필요. [카카오맵] 사용설정만 ON
KAKAO_REST_KEY=

# ── tourAPI (한국관광공사, 폴백 데이터 소스, 선택) ──
# 발급: https://www.data.go.kr (승인 지연 약 10분 주의)
TOURAPI_KEY=

# ── 기타 (일반적으로 불필요) ──
# CI=1 이면 rate-limit 비활성화 + 폴백 강제
# CI=
